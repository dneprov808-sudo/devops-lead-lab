  {
    "id": "KADV-15",
    "namespace": "academy-v12-k15",
    "title": "CronJob lifecycle",
    "task": "Настроить CronJob в suspend=true для безопасной паузы, лимиты истории 2/1 и Forbid concurrency. Вручную выполнить тестовый Job из шаблона с именем cron-proof.",
    "prerequisites": "kind",
    "fixture": "fixtures/KADV-15.json",
    "checks": [
      {
        "type": "field",
        "resource": "cronjob",
        "name": "cron",
        "path": [
          "spec",
          "suspend"
        ],
        "value": true
      },
      {
        "type": "field",
        "resource": "cronjob",
        "name": "cron",
        "path": [
          "spec",
          "concurrencyPolicy"
        ],
        "value": "Forbid"
      },
      {
        "type": "field",
        "resource": "cronjob",
        "name": "cron",
        "path": [
          "spec",
          "successfulJobsHistoryLimit"
        ],
        "value": 2
      },
      {
        "type": "field",
        "resource": "cronjob",
        "name": "cron",
        "path": [
          "spec",
          "failedJobsHistoryLimit"
        ],
        "value": 1
      },
      {
        "type": "field",
        "resource": "job",
        "name": "cron-proof",
        "path": [
          "status",
          "succeeded"
        ],
        "value": 1
      }
    ]
  },
