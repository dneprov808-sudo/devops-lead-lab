  {
    "id": "KADV-05",
    "namespace": "academy-v12-k05",
    "title": "CNI NetworkPolicy",
    "task": "Разрешить HTTP только Pod с label access=allowed, запретить остальные. Подтвердить трафиком, не только YAML.",
    "prerequisites": "CNI with actual NetworkPolicy enforcement (Calico/Cilium or equivalent; default kind networking may not enforce)",
    "fixture": "fixtures/KADV-05.json",
    "checks": [
      {
        "type": "exec",
        "pod": "allowed",
        "argv": [
          "wget",
          "-qO-",
          "-T",
          "3",
          "http://app"
        ],
        "contains": "Welcome to nginx",
        "exit": 0
      },
      {
        "type": "exec",
        "pod": "denied",
        "argv": [
          "wget",
          "-qO-",
          "-T",
          "3",
          "http://app"
        ],
        "contains": "",
        "nonzero": true
      }
    ]
  },
  {
