  {
    "id": "KADV-07",
    "namespace": "academy-v12-k07",
    "title": "ResourceQuota и LimitRange",
    "task": "Настроить quota CPU requests 500m, memory requests 256Mi и ограничить число Pods четырьмя; создать LimitRange с default requests. Проверить workload.",
    "prerequisites": "kind",
    "fixture": "fixtures/KADV-07.json",
    "checks": [
      {
        "type": "field",
        "resource": "resourcequota",
        "name": "budget",
        "path": [
          "spec",
          "hard",
          "pods"
        ],
        "value": "4"
      },
      {
        "type": "field",
        "resource": "resourcequota",
        "name": "budget",
        "path": [
          "spec",
          "hard",
          "requests.cpu"
        ],
        "value": "500m"
      },
      {
        "type": "field",
        "resource": "resourcequota",
        "name": "budget",
        "path": [
          "spec",
          "hard",
          "requests.memory"
