  {
    "id": "KADV-17",
    "namespace": "academy-v12-k17",
    "title": "SecurityContext",
    "task": "Запустить непривилегированный workload: non-root UID 10001, no privilege escalation, drop ALL, seccomp RuntimeDefault. Проверить реальный UID.",
    "prerequisites": "kind",
    "fixture": "fixtures/KADV-17.json",
    "checks": [
      {
        "type": "field",
        "resource": "pod",
        "name": "secure",
        "path": [
          "spec",
          "securityContext",
          "runAsNonRoot"
        ],
        "value": true
      },
      {
        "type": "field",
        "resource": "pod",
        "name": "secure",
        "path": [
          "spec",
          "securityContext",
          "seccompProfile",
          "type"
        ],
        "value": "RuntimeDefault"
      },
      {
        "type": "field",
        "resource": "pod",
        "name": "secure",
        "path": [
          "spec",
          "containers",
          0,
          "securityContext",
          "allowPrivilegeEscalation"
        ],
        "value": false
      },
      {
        "type": "field",
        "resource": "pod",
        "name": "secure",
        "path": [
          "spec",
          "containers",
          0,
          "securityContext",
          "capabilities",
          "drop"
        ],
        "value": [
          "ALL"
        ]
      },
      {
        "type": "exec",
        "pod": "secure",
        "argv": [
          "id",
          "-u"
        ],
        "contains": "10001",
        "exit": 0
      }
    ]
  },
