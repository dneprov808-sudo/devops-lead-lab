  {
    "id": "KADV-01",
    "namespace": "academy-v12-k01",
    "title": "Resource requests и scheduling",
    "task": "Приложение не размещается. Найди причину и восстанови Pod с согласованным budget: 50m/32Mi requests, 200m/128Mi limits.",
    "prerequisites": "kind",
    "fixture": "fixtures/KADV-01.json",
    "checks": [
      {
        "type": "field",
        "resource": "deployment",
        "name": "app",
        "path": [
          "status",
          "availableReplicas"
        ],
        "value": 1
      },
      {
        "type": "field",
        "resource": "deployment",
        "name": "app",
        "path": [
          "spec",
          "template",
          "spec",
          "containers",
          0,
          "resources",
          "requests",
          "cpu"
        ],
        "value": "50m"
      },
      {
        "type": "field",
        "resource": "deployment",
        "name": "app",
        "path": [
          "spec",
          "template",
          "spec",
          "containers",
          0,
          "resources",
          "limits",
          "memory"
        ],
        "value": "128Mi"
      }
    ]
  },
  {
