{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "task",
        "namespace": "academy-v12-k14"
      },
      "spec": {
        "backoffLimit": 1,
        "template": {
          "spec": {
            "restartPolicy": "Never",
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "task",
                "image": "busybox:1.36.1",
                "command": [
                  "sh",
                  "-c",
                  "exit 1"
                ]
              }
            ]
          }
        }
      }
    }
  ]
}
