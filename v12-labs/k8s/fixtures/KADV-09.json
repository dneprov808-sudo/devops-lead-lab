{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "app",
        "namespace": "academy-v12-k09"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "v12-app"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "v12-app"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "app",
                "image": "nginx:1.28-alpine",
                "ports": [
                  {
                    "containerPort": 80
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "200m",
                    "memory": "128Mi"
                  }
                }
              }
            ],
            "nodeSelector": {
              "kubernetes.io/os": "nonexistent"
            }
          }
        }
      }
    }
  ]
}
