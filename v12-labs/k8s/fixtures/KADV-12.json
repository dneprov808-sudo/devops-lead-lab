{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "data",
        "namespace": "academy-v12-k12"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "64Mi"
          }
        },
        "storageClassName": "missing-csi"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "data-probe",
        "namespace": "academy-v12-k12"
      },
      "spec": {
        "automountServiceAccountToken": false,
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "probe",
            "image": "busybox:1.36.1",
            "command": [
              "sh",
              "-c",
              "test -f /data/marker || echo academy-v12 > /data/marker; sleep 3600"
            ],
            "volumeMounts": [
              {
                "name": "data",
                "mountPath": "/data"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "10m",
                "memory": "8Mi"
              },
              "limits": {
                "cpu": "100m",
                "memory": "64Mi"
              }
            }
          }
        ],
        "volumes": [
          {
            "name": "data",
            "persistentVolumeClaim": {
              "claimName": "data"
            }
          }
        ]
      }
    }
  ]
}
