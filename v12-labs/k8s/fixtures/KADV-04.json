{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "app",
        "namespace": "academy-v12-k04"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "v12-app"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "v12-app"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "app",
                "image": "nginx:1.28-alpine",
                "ports": [
                  {
                    "containerPort": 80
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "200m",
                    "memory": "128Mi"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "wrong",
        "namespace": "academy-v12-k04"
      },
      "spec": {
        "selector": {
          "app": "v12-app"
        },
        "ports": [
          {
            "port": 80,
            "targetPort": 80
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "probe",
        "namespace": "academy-v12-k04"
      },
      "spec": {
        "automountServiceAccountToken": false,
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "probe",
            "image": "busybox:1.36.1",
            "command": [
              "sleep",
              "3600"
            ],
            "resources": {
              "requests": {
                "cpu": "10m",
                "memory": "8Mi"
              },
              "limits": {
                "cpu": "100m",
                "memory": "64Mi"
              }
            }
          }
        ]
      }
    }
  ]
}
