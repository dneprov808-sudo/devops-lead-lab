{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "stateful",
        "namespace": "academy-v12-k13"
      },
      "spec": {
        "selector": {
          "app": "stateful"
        },
        "ports": [
          {
            "port": 80
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "stateful",
        "namespace": "academy-v12-k13"
      },
      "spec": {
        "serviceName": "stateful",
        "replicas": 2,
        "selector": {
          "matchLabels": {
            "app": "stateful"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "stateful"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "app",
                "image": "nginx:1.28-alpine",
                "ports": [
                  {
                    "containerPort": 80
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "probe",
        "namespace": "academy-v12-k13"
      },
      "spec": {
        "automountServiceAccountToken": false,
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "probe",
            "image": "busybox:1.36.1",
            "command": [
              "sleep",
              "3600"
            ],
            "resources": {
              "requests": {
                "cpu": "10m",
                "memory": "8Mi"
              },
              "limits": {
                "cpu": "100m",
                "memory": "64Mi"
              }
            }
          }
        ]
      }
    }
  ]
}
